{
  "name": "rideshare-analytics",
  "version": "1.0.0",
  "description": "Data collection and visualization system for the NationalLifeCoverage.org quote landing page",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node setup.js",
    "build": "echo 'Build complete - static files ready'",
    "deploy": "bash deploy.sh",
    "install-deps": "npm install",
    "submit:proxy": "node scripts/submitWithResidentialProxy.js",
    "submit:production": "node scripts/submitProductionFunnel.js",
    "behavior:test": "node scripts/behavioralTestRunner.js",
    "test": "npm run test:unit && npm run test:offline",
    "test:unit": "node test/unit.js",
    "test:offline": "node test/offline-selftest.js"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^8.0.3",
    "pdfkit": "^0.14.0",
    "playwright-core": "^1.55.0",
    "useragent": "^2.3.0",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "analytics",
    "data-visualization",
    "life-insurance",
    "landing-page"
  ],
  "author": "NationalLifeCoverage.org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbarnes4318/rideshare.git"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
