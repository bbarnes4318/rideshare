# Residential browser submission runner + production app environment.
# Copy to /opt/rideshare/.env on the server and fill in the real secrets there.
# Keep real credentials in the server environment only; never commit them.

NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rideshare
# --- Residential proxy provider -------------------------------------------
# Which vendor the runners use. "shifter" (default) or "iproyal". An unknown
# value is a startup error, not a silent fallback. There is no automatic
# failover between the two: switching is a deliberate change to this line.
PROXY_PROVIDER=shifter

# Shifter (primary). One gateway for everything; targeting and the sticky
# session are encoded as dash-separated flags appended to the USERNAME, and the
# password is sent unmodified:
#   customer-USER-country-us-region-new_jersey-city-jersey_city-strict-true-sid-<id>-ttl-<sec>
# Region and city names are lowercase with underscores for spaces.
SHIFTER_PROXY_HOST=p.shifter.io
SHIFTER_PROXY_PORT=443
SHIFTER_PROXY_USERNAME=customer-YOUR_SHIFTER_USERNAME
SHIFTER_PROXY_PASSWORD=YOUR_SHIFTER_PASSWORD
# Sticky IP lifetime in SECONDS (Shifter's own default is 120, which expires
# part-way through a funnel run).
SHIFTER_SESSION_TTL_SECONDS=1800
# Candidate sticky sessions probed per targeting tier before widening.
SHIFTER_SESSION_ATTEMPTS=8
# strict-true on the city and state tiers: refuse rather than silently widen,
# so a tier that cannot be served says so instead of burning probes on IPs that
# were never going to match. Set to false to restore gateway broadening.
SHIFTER_STRICT_TARGETING=true

# IPRoyal (selectable fallback: set PROXY_PROVIDER=iproyal). Targeting is
# encoded in the PASSWORD here, and location tokens have no separators at all.
IPROYAL_PROXY_HOST=geo.iproyal.com
IPROYAL_PROXY_PORT=12321
IPROYAL_PROXY_USERNAME=YOUR_IPROYAL_USERNAME
IPROYAL_PROXY_PASSWORD=YOUR_IPROYAL_PASSWORD
IPROYAL_SESSION_ATTEMPTS=8
IPROYAL_SESSION_LIFETIME_MINUTES=30

TRUSTEDFORM_TARGET_URL=https://quotes.nationallifecoverage.org/
PROXY_IP_CHECK_URL=https://ipv4.icanhazip.com

# Required test lead fields
TEST_ZIP=00000
TEST_DOB=01/01/1970
TEST_ADDRESS=123 Main St
TEST_FNAME=Test
TEST_LNAME=Lead
TEST_EMAIL=test@example.com
TEST_PHONE=5555555555

# Optional fields (the runner supplies safe test defaults for these)
TEST_GENDER=Male
TEST_CURRENTLY_INSURED=No
TEST_CREDIT_RATING=good
TEST_MARITAL=No
TEST_HOMEOWNER=Yes
TEST_MILITARY=No
TEST_TOBACCO=No
TEST_CANCER=No
TEST_HEART_DISEASE=No
TEST_COVERAGE=$25,000
TEST_HEIGHT=70
TEST_WEIGHT=160

# Set to the installed browser executable on the machine running the script.
# Detect with: for b in /usr/bin/chromium /usr/bin/chromium-browser /usr/bin/google-chrome; do
#   [ -x "$b" ] && echo "$b"; done
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
HEADLESS=true
# HEADLESS=false

# --- Behavioral test harness (scripts/behavioralTestRunner.js) -------------
# All optional; the defaults below are what the harness uses when unset.
# BEHAVIOR_REPORT_DIR=test-reports
# BEHAVIOR_RANGE_SHORT=10-35
# BEHAVIOR_RANGE_MEDIUM=35-100
# BEHAVIOR_RANGE_LONG=100-240
# BEHAVIOR_EXPECTED_STEPS=16
# BEHAVIOR_PAUSE_MIN_MS=250
# BEHAVIOR_PAUSE_MAX_MS=25000
# BEHAVIOR_TYPING_CPM_MIN=150
# BEHAVIOR_TYPING_CPM_MAX=480
# BEHAVIOR_SCROLL_PROBABILITY=0.55
# BEHAVIOR_SCROLL_MIN_PX=120
# BEHAVIOR_SCROLL_MAX_PX=700
# BEHAVIOR_STEP_SETTLE_MAX_MS=10000
# BEHAVIOR_RESPONSE_WAIT_MS=15000
# BEHAVIOR_SUBMIT_RESERVE_MS=2500
# BEHAVIOR_TF_TIMEOUT_MS=30000
# BEHAVIOR_BETWEEN_RUNS_MS=3000
# BEHAVIOR_TELEMETRY_KEYS=redacted
# BEHAVIOR_ENTRY_MODE=type
